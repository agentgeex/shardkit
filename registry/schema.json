{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI Component Registry Item",
  "type": "object",
  "required": ["id", "name", "category", "tags", "stack", "source", "complexity"],
  "properties": {
    "id": { "type": "string", "description": "唯一标识，如 button-primary" },
    "name": { "type": "string", "description": "中文展示名，如 主按钮" },
    "category": {
      "type": "string",
      "enum": [
        "01-basic", "02-form", "03-layout", "04-navigation",
        "05-data-display", "06-feedback", "07-overlay", "08-advanced"
      ]
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "stack": { "type": "string", "enum": ["shadcn", "tailwind", "radix", "antd", "mui", "coreui", "vue", "vanilla"] },
    "source": { "type": "string", "description": "自研 / shadcn-official / Horizon / TailAdmin / CodePen / 历史项目" },
    "complexity": { "type": "string", "enum": ["片段", "组件", "区块", "页面"] },
    "scene": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["可用", "待整理", "弃用"] },
    "usability": { "type": "string", "enum": ["copy-paste", "需适配", "需依赖"] },
    "preview": { "type": "string", "description": "/previews/xxx.png" },
    "demo": { "type": "string", "description": "registry-items/xxx/demo.tsx" },
    "files": { "type": "array", "items": { "type": "string" }, "description": "需要复制到消费方的文件清单" },
    "deps": { "type": "array", "items": { "type": "string" }, "description": "运行所需依赖（npm 包名）" },
    "installCmd": { "type": "string", "description": "依赖安装命令快照，如 npm i @radix-ui/react-slot class-variance-authority" },
    "targetDir": { "type": "string", "description": "复制到消费方的建议目标目录，如 src/components/ui" },
    "createdAt": { "type": "string" }
  }
}
