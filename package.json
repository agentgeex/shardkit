{
  "name": "shardkit",
  "version": "0.1.0",
  "private": true,
  "description": "ShardKit — a copy-in UI shard kit. Browse, preview, copy, ship. A searchable, previewable, copy-pasteable UI component registry & showcase.",
  "keywords": [
    "ui",
    "components",
    "registry",
    "shadcn",
    "tailwind",
    "copy-in",
    "copy-paste",
    "showcase",
    "gallery",
    "react"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:registry": "node scripts/build-registry.mjs",
    "build:cases": "node scripts/build-cases.mjs",
    "build:meta": "npm run build:registry && npm run build:cases",
    "dev": "npm run build:meta && vite --host --port 5178",
    "build": "npm run build:meta && tsc -b && vite build",
    "preview": "npm run build:meta && vite preview --host --port 4178"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@refinedev/core": "^4.57.0",
    "@refinedev/react-router-v6": "^4.6.0",
    "@tanstack/react-query": "^5.59.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@uiw/react-md-editor": "^4.1.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "i18next": "^23.16.8",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.15.4",
    "shiki": "^1.24.2",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentgeex/shardkit.git"
  },
  "homepage": "https://github.com/agentgeex/shardkit#readme",
  "bugs": {
    "url": "https://github.com/agentgeex/shardkit/issues"
  }
}
